NODE_ENV=development
PORT=3000

# Local dev: matches docker-compose.yml. Staging/prod: paste your Supabase/Neon connection string.
DATABASE_URL=postgresql://codearena:codearena@localhost:5432/codearena_dev

# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=changeme_access_secret
JWT_REFRESH_SECRET=changeme_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
