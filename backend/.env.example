NODE_ENV=development
PORT=3000

# Local dev: matches docker-compose.yml. Staging/prod: paste your Supabase/Neon connection string.
DATABASE_URL=postgresql://codearena:codearena@localhost:5432/codearena_dev

# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=changeme_access_secret
JWT_REFRESH_SECRET=changeme_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Redis connection string (e.g., redis://:password@host:port)
REDIS_URL=redis://localhost:6379

# Timeout for code execution in milliseconds (default: 5000ms = 5s)
CODE_EXECUTION_TIMEOUT_MS=5000

# Rate limiter for submissions endpoint
# Refill rate (tokens per second)
SUBMISSION_RATE_LIMIT_REFILL=10
# Bucket capacity (maximum burst)
SUBMISSION_RATE_LIMIT_CAPACITY=10